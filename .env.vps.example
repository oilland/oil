# ───────────────────────────────────────────────────────────
#  روغن‌لند — متغیرهای محیطی VPS
#  این فایل را کپی کن به نام .env  و مقادیر را پر کن:
#      cp .env.vps.example .env
#  هشدار: فایل .env را هرگز جایی share نکن و در گیت‌هاب نگذار.
# ───────────────────────────────────────────────────────────

# رمز دیتابیس Postgres (خودت یک رمز قوی بگذار — هرچه می‌خواهی)
POSTGRES_PASSWORD=

# کلید امنیتی برنامه — یک رشتهٔ تصادفی بلند.
# برای ساختنش این را در سرور بزن:   openssl rand -hex 32
# نکته: اگر می‌خواهی کاربرهای فعلی لازم نباشد دوباره لاگین کنند،
#       همان AUTH_SECRET لیارا را اینجا بگذار (اختیاری).
AUTH_SECRET=

# آدرس نهایی سایت (با https)
APP_URL=https://oilland.shop

# آدرسی که Caddy روی آن گواهی HTTPS می‌گیرد.
#  • مرحلهٔ تست (قبل از دامنه):   SITE_ADDRESS=:80
#  • بعد از وصل‌کردن دامنه:        SITE_ADDRESS=oilland.shop
SITE_ADDRESS=:80
