# ─────────────────────────────────────────────────────────────
#  Database (PostgreSQL)
#  Local dev:
DATABASE_URL="postgresql://oilshop:oilshop@localhost:5432/oilshop?schema=public"
#  Production (Liara): the DATABASE_URL is provided by Liara's managed database
# DATABASE_URL="postgresql://user:pass@host:5432/dbname?schema=public"

# ─────────────────────────────────────────────────────────────
#  Security
AUTH_SECRET="change-me-to-a-long-random-string"

# ─────────────────────────────────────────────────────────────
#  Redis (optional — falls back to in-memory cache when unset)
REDIS_URL=""

# ─────────────────────────────────────────────────────────────
#  App
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
#  Payment gateway (Iranian providers — Zarinpal / IDPay / etc.)
#  Stored per-gateway in the admin Settings panel; env fallbacks:
PAYMENT_ZARINPAL_MERCHANT_ID=""
PAYMENT_IDPAY_API_KEY=""

# ─────────────────────────────────────────────────────────────
#  Email / SMS
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMS_PROVIDER_API_KEY=""
